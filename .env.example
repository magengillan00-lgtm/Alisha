# Alisha Environment Variables
# Copy this file to .env.local and fill in your API keys
# These keys are used server-side only (during dev with `next dev`)
# In production (static export), users enter keys via the Settings UI

# Speech-to-Text (optional - users can also enter via Settings)
ASSEMBLYAI_API_KEY=

# Note: All LLM provider keys (Gemini, OpenRouter, etc.) are entered
# by users in the Settings dialog and stored in their browser's localStorage.
# They are NOT read from environment variables in production.
