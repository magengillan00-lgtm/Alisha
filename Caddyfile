# Caddyfile لـ Alisha - تم إصلاحه
# ✅ تم إزالة ثغرة SSRF (XTransformPort)
# ✅ تفعيل HTTPS التلقائي عبر Caddy
# ✅ إضافة security headers

alisha.dpdns.org {
    root * /var/www/alisha/out
    file_server

    # Cache للملفات الثابتة
    header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
    header /images/* Cache-Control "public, max-age=86400"

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob: data: https:; connect-src 'self' https://generativelanguage.googleapis.com https://api-inference.huggingface.co https://integrate.api.nvidia.com https://api.groq.com https://api.together.xyz https://openrouter.ai https://api.cohere.ai https://api.mistral.ai https://api.abliteration.ai https://api.assemblyai.com wss://streaming.assemblyai.com https://*.supabase.co; font-src 'self' data:; frame-ancestors 'none'"
    }

    # Gzip compression
    encode gzip zstd

    # SPA fallback
    try_files {path} {path}/index.html /index.html
}
